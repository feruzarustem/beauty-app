generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  master
}

enum MasterCategory {
  lash
  nail
  lami_brow
  hair
}

enum ServiceKind {
  main
  addon
  option
}

enum PaymentMethod {
  cash
  kaspi
  transfer
}

enum VisitStatus {
  scheduled
  done
  cancelled
}

enum PayoutStatus {
  pending
  paid
}

model User {
  id           String  @id @default(cuid())
  name         String
  login        String  @unique
  passwordHash String
  role         Role
  active       Boolean @default(true)
  category     MasterCategory?

  clients     Client[]
  visits      Visit[]  @relation("VisitMaster")
  createdVisits Visit[] @relation("VisitCreator")
  payouts     Payout[] @relation("PayoutMaster")
}

model Client {
  id               String  @id @default(cuid())
  name             String
  assignedMasterId String?
  assignedMaster   User?   @relation(fields: [assignedMasterId], references: [id])
  contact          ClientContact?
  visits           Visit[]
  createdAt        DateTime @default(now())
}

model ClientContact {
  clientId  String   @id
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phone     String
  consentAt DateTime
}

model Visit {
  id            String        @id @default(cuid())
  visitDate     DateTime      @db.Date
  masterId      String
  master        User          @relation("VisitMaster", fields: [masterId], references: [id])
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  amount        Int
  paymentMethod PaymentMethod
  createdById   String
  createdBy     User          @relation("VisitCreator", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  // Расписание и визиты — одна таблица. Старые визиты (без времени) считаются выполненными.
  startTime       String?
  status          VisitStatus   @default(done)
  completedAt     DateTime?
  completedById   String?
  cancelledReason String?
  adjustments   VisitAdjustment[]
  items         VisitItem[]

  @@index([visitDate, masterId])
  @@index([visitDate, status])
}

model VisitAdjustment {
  id          String   @id @default(cuid())
  visitId     String
  visit       Visit    @relation(fields: [visitId], references: [id])
  oldAmount   Int
  newAmount   Int
  reason      String
  changedById String
  changedAt   DateTime @default(now())
}

model DayClosing {
  id           String   @id @default(cuid())
  closingDate  DateTime @unique @db.Date
  expectedCash Int
  actualCash   Int
  difference   Int
  closedById   String
  closedAt     DateTime @default(now())
  comment      String?
  // Зафиксированные при закрытии показатели (из выполненных визитов дня)
  visitCount    Int      @default(0)
  revenue       Int      @default(0)
  mastersTotal  Int      @default(0)
  salonShare    Int      @default(0)
  cashTotal     Int      @default(0)
  kaspiTotal    Int      @default(0)
  transferTotal Int      @default(0)
  isClosed      Boolean  @default(true)
  reopenedAt    DateTime?
  reopenedById  String?
  reopenReason  String?
}

/// Выходной мастера. Выходной одного мастера не влияет на остальных.
model DayOff {
  id          String   @id @default(cuid())
  masterId    String
  date        DateTime @db.Date
  createdById String
  createdAt   DateTime @default(now())

  @@unique([masterId, date])
  @@index([date])
}

/// Журнал аудита: кто, что и когда изменил.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actorId  String
  action   String
  entity   String
  entityId String?
  details  String?

  @@index([at])
}

model Payout {
  id               String       @id @default(cuid())
  masterId         String
  master           User         @relation("PayoutMaster", fields: [masterId], references: [id])
  periodStart      DateTime     @db.Date
  periodEnd        DateTime     @db.Date
  calculatedAmount Int
  adjustmentAmount Int          @default(0)
  adjustmentReason String?
  finalAmount      Int
  status           PayoutStatus @default(pending)
  paidAt           DateTime?
  paidById         String?

  @@unique([masterId, periodStart, periodEnd])
}

model Setting {
  key   String @id
  value String
}

model Service {
  id        String         @id @default(cuid())
  category  MasterCategory
  groupName String
  name      String
  priceMin  Int
  priceMax  Int?
  openEnded Boolean        @default(false)
  details   String?
  sortOrder Int            @default(0)
  kind      ServiceKind    @default(main)

  @@unique([category, groupName, name])
}

/// Позиция визита: снимок услуги на момент записи. Visit.amount = сумма price всех позиций.
model VisitItem {
  id             String      @id @default(cuid())
  visitId        String
  visit          Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  serviceId      String?
  name           String
  kind           ServiceKind
  priceMin       Int
  price          Int
  belowMinReason String?
  setById        String
  createdAt      DateTime    @default(now())

  @@index([visitId])
}
